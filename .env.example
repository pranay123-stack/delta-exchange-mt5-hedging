# Copy to .env and adjust. Nothing here is secret in a paper deployment, and
# the platform has no live venue credentials to configure in the first place.

# --- ports (chosen to avoid colliding with other local stacks) -------------
FRONTEND_PORT=5174
BACKEND_PORT=8001
POSTGRES_PORT=5468
REDIS_PORT=6479

# --- database --------------------------------------------------------------
POSTGRES_USER=hedgelab
POSTGRES_PASSWORD=hedgelab
POSTGRES_DB=hedgelab

# --- application -----------------------------------------------------------
HEDGELAB_ENVIRONMENT=local
HEDGELAB_LOG_LEVEL=INFO
HEDGELAB_LOG_JSON=true
HEDGELAB_ACCOUNT_CURRENCY=USD
HEDGELAB_PAPER_STARTING_BALANCE=250000
HEDGELAB_SIMULATOR_SEED=20260908

# --- access control --------------------------------------------------------
# user:role:key triples, comma separated. Roles: VIEWER, TRADER, ADMIN.
# Leave unset for open access, which is ONLY permitted when
# HEDGELAB_ENVIRONMENT is "local" or "test" -- the API refuses to start
# unauthenticated in any other environment.
# HEDGELAB_API_KEYS=demo:ADMIN:change-me,readonly:VIEWER:also-change-me

# HEDGELAB_TRADING_MODE is intentionally absent: it is PAPER and the container
# entrypoint refuses to start with any other value.
